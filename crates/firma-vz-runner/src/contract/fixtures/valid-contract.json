{
  "version": 1,
  "sandbox_id": "sandbox-test",
  "runtime_dir": "${ROOT}/runtime",
  "runner": {
    "path": "${ROOT}/firma-vz-runner"
  },
  "guest": {
    "kernel": "${ROOT}/vmlinuz",
    "initrd": "${ROOT}/initrd.img",
    "rootfs": "${ROOT}/rootfs.img"
  },
  "command": {
    "executable": "codex",
    "args": ["--version"],
    "cwd": "${ROOT}",
    "env": {},
    "identity_mode": "host_user",
    "seccomp_filter_path": "${ROOT}/seccomp.bpf"
  },
  "terminal": {
    "interactive": false,
    "pty": false,
    "pty_vsock_port": null,
    "pty_control_vsock_port": null,
    "term": null,
    "rows": null,
    "cols": null
  },
  "mounts": [
    {
      "source": "${ROOT}",
      "target": "/workspace",
      "read_only": false
    }
  ],
  "network": {
    "mode": "vsock_sidecar",
    "guest_http_proxy_addr": "127.0.0.1:18080",
    "guest_dns_stub_addr": "127.0.0.1:1053",
    "vsock_sidecar_port": 18080,
    "sidecar_host_addr": "127.0.0.1:19080",
    "direct_network_devices_allowed": false,
    "dns_mode": "confined_stub",
    "attribution_headers": {
      "x-firma-sandbox-id": "sandbox-test"
    }
  },
  "invariants": [
    {
      "name": "sidecar_only_egress",
      "mode": "required"
    },
    {
      "name": "dns_confined",
      "mode": "required"
    },
    {
      "name": "fail_closed_startup",
      "mode": "required"
    },
    {
      "name": "fail_closed_runtime",
      "mode": "required"
    },
    {
      "name": "direct_bypass_resistant",
      "mode": "required"
    },
    {
      "name": "preserve_stdio_signals_exit",
      "mode": "required"
    }
  ]
}
