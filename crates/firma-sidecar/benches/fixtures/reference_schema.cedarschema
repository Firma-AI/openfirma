namespace Firma {
    entity Agent;
    entity Resource;
    action "bench.action.allow" appliesTo { principal: [Agent], resource: [Resource], context: { risk_score: Long } };
    action "bench.action.deny"  appliesTo { principal: [Agent], resource: [Resource], context: { risk_score: Long } };
    action "bench.action.ctx"   appliesTo { principal: [Agent], resource: [Resource], context: { risk_score: Long } };
    // Full `EnforcementContext` shape as built by `ConstraintEnforcer::build_context`.
    // Used by the pipeline end-to-end bench where the normalizer emits a canonical
    // registry action class and Stage 2 assembles the full context.
    action "communication.external.send" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: {
            session_id: String,
            timestamp_ms: Long,
            params: String,
            risk_score: Long,
            session_duration_s: Long,
            action_count: Long,
            raw_transport: String,
            deny_count: Long,
            prior_action_classes: Set<String>,
            last_resource: String,
            transfer_amount: Long,
            daily_cumulative_amount: Long,
            transfers_last_10m: Long,
            same_payee_count_30m: Long,
            session_transfer_count: Long
        }
    };
}
