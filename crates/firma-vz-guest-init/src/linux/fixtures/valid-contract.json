{
  "version": 1,
  "sandbox_id": "sandbox-test",
  "runtime_dir": "/runtime",
  "runner": {
    "path": "/firma-vz-runner"
  },
  "guest": {
    "kernel": "/vmlinuz",
    "initrd": "/initrd.img",
    "rootfs": "/rootfs.img"
  },
  "command": {
    "executable": "/bin/true",
    "args": [],
    "cwd": "/workspace",
    "env": {},
    "identity_mode": "sandbox_user"
  },
  "terminal": {
    "interactive": false,
    "pty": false,
    "pty_vsock_port": null,
    "pty_control_vsock_port": null,
    "term": null,
    "rows": null,
    "cols": null
  },
  "mounts": [
    {
      "source": "/workspace",
      "target": "/workspace",
      "read_only": false
    }
  ],
  "network": {
    "mode": "vsock_sidecar",
    "guest_http_proxy_addr": "127.0.0.1:18080",
    "guest_dns_stub_addr": "127.0.0.1:1053",
    "vsock_sidecar_port": 18080,
    "sidecar_host_addr": "127.0.0.1:19080",
    "direct_network_devices_allowed": false,
    "dns_mode": "confined_stub",
    "attribution_headers": {
      "x-firma-sandbox-id": "sandbox-test"
    }
  },
  "invariants": [
    {
      "name": "preserve_stdio_signals_exit",
      "mode": "required"
    }
  ]
}
