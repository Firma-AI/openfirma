// Firma enforcement schema.
//
// Canonical entity types and action declarations for capability issuance
// (Authority) and constraint enforcement (Sidecar Stage 2). Single source of
// truth for entity type definitions shared across both components.
//
// The action identifiers below are defined by FEP v0.1 §2.3.5 plus the
// GitHub-focused registry extension used by the demos. They are semantic
// action classes; transport names and provider names MUST NOT appear in
// action identifiers (FEP §2.3.2). The base registry is listed first, followed
// by the demo extension. See
// `docs/markdown/firma_action_class_registry.md` for implementation notes.
//
// Entity UID conventions (matched by both Authority and Sidecar Cedar evaluators):
//   principal: Firma::Agent::"<agent_id>"
//   action:    Firma::Action::"<action_class>"   (e.g., "communication.external.send")
//   resource:  Firma::Resource::"<resource_uri>"
//
// Context attributes populated by ConstraintEnforcer::build_context():
//   session_id         : String  - enclosing session identity
//   timestamp_ms       : Long    - Unix epoch milliseconds at evaluation time
//   params             : String  - JSON-serialized intent.params (ActionParams)
//   risk_score         : Long    - static or pre-computed risk attribute (V1 = 0)
//   session_duration_s : Long    - seconds since claims.issued_at (non-negative)
//   action_count       : Long    - monotonic per-session call counter, 1-based
//   raw_transport      : String  - "http" or "https"; set by the normalizer
//   deny_count         : Long    - cumulative denied actions in this session (AARM R2 G3)
//   prior_action_classes: Set<String> - bounded recent action classes (deduped, first-seen order)
//   last_resource      : String  - resource of the most recent prior action ("" if none)
//   git_provider       : String  - optional Git provider tag, currently "github"
//   git_owner          : String  - optional repository owner or organization
//   git_repo           : String  - optional repository name
//   git_ref            : String  - optional full ref name, e.g. "refs/heads/main"
//   git_ref_type       : String  - optional coarse ref kind: branch, tag, or ref
//   git_operation      : String  - optional coarse Git operation: read, write, or delete
namespace Firma {
    entity Agent;
    entity Resource {
        id: String,
        // secret.redact: outbound HTTP request fields.
        host?: String,
        path?: String,
        method?: String
    };

    // Shared context shape for all canonical enforcement actions.
    // Must match the JSON object produced by ConstraintEnforcer::build_context().
    //
    // Fields:
    //   session_id              : String — enclosing session identity
    //   timestamp_ms            : Long   — Unix epoch milliseconds at evaluation time
    //   params                  : String — JSON-serialized intent.params (ActionParams)
    //   risk_score              : Long   — static or pre-computed risk attribute (V1 = 0)
    //   session_duration_s      : Long   — seconds since claims.issued_at (non-negative)
    //   action_count            : Long   — monotonic per-session call counter, 1-based
    //   raw_transport           : String — "http" or "https"; set by the normalizer
    //   deny_count              : Long   — cumulative denied actions in this session (AARM R2 G3)
    //   prior_action_classes    : Set<String> — bounded recent action classes (deduped)
    //   last_resource           : String — resource of the most recent prior action ("" if none)
    //   transfer_amount         : Long   — amount of this transfer in cents; 0 for non-payment actions
    //   daily_cumulative_amount : Long   — rolling 24-hour committed amount in cents
    //   transfers_last_10m      : Long   — transfer count in the last 10-minute window
    //   same_payee_count_30m    : Long   — transfers to the same payee in the last 30 minutes
    //   session_transfer_count  : Long   — count of transfers in this session
    //   git_provider            : String — optional Git provider tag, currently "github"
    //   git_owner               : String — optional repository owner or organization
    //   git_repo                : String — optional repository name
    //   git_ref                 : String — optional full ref name, e.g. "refs/heads/main"
    //   git_ref_type            : String — optional coarse ref kind: branch, tag, or ref
    //   git_operation           : String — optional coarse Git operation: read, write, or delete
    type EnforcementContext = {
        session_id: String,
        timestamp_ms: Long,
        params: String,
        risk_score: Long,
        session_duration_s: Long,
        action_count: Long,
        raw_transport: String,
        deny_count: Long,
        prior_action_classes: Set<String>,
        last_resource: String,
        transfer_amount: Long,
        daily_cumulative_amount: Long,
        transfers_last_10m: Long,
        same_payee_count_30m: Long,
        session_transfer_count: Long,
        git_provider?: String,
        git_owner?: String,
        git_repo?: String,
        git_ref?: String,
        git_ref_type?: String,
        git_operation?: String
    };

    action "account.permission.change" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "browser.purchase" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.external.send" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.internal.send" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "credential.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "credential.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "filesystem.delete" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "filesystem.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "filesystem.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "memory.cross_namespace.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "memory.cross_namespace.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.purchase" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.transfer" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "system.execute" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "system.install" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    // GitHub additions (12 action classes added in the v0.1 registry extension).
    action "code.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.review.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.review.submit" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.destructive" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.merge" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "issue.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "issue.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "notification.manage" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "security.alert.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "repo.lifecycle" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "repo.admin" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    // Stripe coverage additions.
    action "payment.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.cancel" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.refund" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.payout" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.dispute" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.subscription" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.method.setup" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.method.manage" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.catalog.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.tax" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "customer.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "customer.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    // Gmail coverage additions.
    action "communication.external.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.external.draft" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.external.manage" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.external.delete" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.external.filter" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    // OpenFirma secret-redact grant (Sidecar MITM path).
    // Authorises placeholder rehydration (outbound) and secret masking (inbound)
    // for a specific outbound HTTP destination.
    // resource.host — the outbound request Host header (e.g. "api.github.com").
    // resource.path — the request path (e.g. "/user/repos").
    // resource.method — the HTTP method (e.g. "GET", "POST").
    action "secret.redact" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };
}
