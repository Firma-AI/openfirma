# Generated by `firma init`. Base routing rules.
# Provider and service mappings are in mappings/ — loaded via rules_paths.
# Hosts NOT covered by any rule are DENIED before Cedar (default_protected = true).

# ─── Localhost fallthrough ────────────────────────────────────────────────────

[[rules]]
host         = "localhost:*"
path         = "*"
action_class = "communication.internal.send"

[[rules]]
host         = "127.0.0.1:*"
path         = "*"
action_class = "communication.internal.send"
{% if extra_hosts %}

# ─── Extra hosts ─────────────────────────────────────────────────────────────
{% for host in extra_hosts %}
[[rules]]
method       = "CONNECT"
host         = "{{ host }}:443"
action_class = "communication.external.send"

[[rules]]
host         = "{{ host }}"
path         = "*"
action_class = "communication.external.send"
{% endfor %}
{% endif %}
