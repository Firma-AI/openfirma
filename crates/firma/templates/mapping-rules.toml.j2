# Generated by `firma init`. Supplemental mapping rules.
# Provider-specific rules (GitHub, Gmail) are in mappings/ — loaded via rules_paths.
# Hosts NOT covered by any rule are DENIED before Cedar (default_protected = true).

# ─── LLM API ──────────────────────────────────────────────────────────────────
# Tunnels through without MITM; the LLM SDK does not need to trust firma-ca.

{% if provider == "anthropic" -%}
[[rules]]
method       = "CONNECT"
host         = "api.anthropic.com:443"
action_class = "communication.external.send"
{% elif provider == "openai" -%}
[[rules]]
method       = "CONNECT"
host         = "api.openai.com:443"
action_class = "communication.external.send"
{% else -%}
# TODO: add your LLM provider CONNECT rule here.
# [[rules]]
# method       = "CONNECT"
# host         = "api.your-llm.com:443"
# action_class = "communication.external.send"
{% endif %}
# ─── HTTPS CONNECT tunnels (MITM targets) ─────────────────────────────────────

[[rules]]
method       = "CONNECT"
host         = "api.github.com:443"
action_class = "code.review.read"

[[rules]]
method       = "CONNECT"
host         = "gmail.googleapis.com:443"
action_class = "communication.external.send"

# ─── Package managers ─────────────────────────────────────────────────────────

[[rules]]
host         = "pypi.org"
path         = "*"
action_class = "system.install"

[[rules]]
host         = "files.pythonhosted.org"
path         = "*"
action_class = "system.install"

[[rules]]
method       = "CONNECT"
host         = "pypi.org:443"
action_class = "system.install"

[[rules]]
host         = "crates.io"
path         = "*"
action_class = "system.install"

[[rules]]
host         = "static.crates.io"
path         = "*"
action_class = "system.install"

[[rules]]
host         = "registry.npmjs.org"
path         = "*"
action_class = "system.install"

# ─── Localhost fallthrough ────────────────────────────────────────────────────

[[rules]]
host         = "localhost:*"
path         = "*"
action_class = "communication.internal.send"

[[rules]]
host         = "127.0.0.1:*"
path         = "*"
action_class = "communication.internal.send"
{% if extra_hosts %}

# ─── Extra hosts ─────────────────────────────────────────────────────────────
{% for host in extra_hosts %}
[[rules]]
method       = "CONNECT"
host         = "{{ host }}:443"
action_class = "communication.external.send"

[[rules]]
host         = "{{ host }}"
path         = "*"
action_class = "communication.external.send"
{% endfor %}
{% endif %}
