# Generated by `firma init`. Agent: {{ name }}
# NOT FOR PRODUCTION USE — local dev/testing only.
# Run from this directory: firma stack start --config firma.toml

# ── Mini Authority ────────────────────────────────────────────────────────────

[authority]
listen_addr = "127.0.0.1:50051"
policy_dir = "policies/"
issuance_policy_dir = "issuance-policies/"
revocation_file = ".runtime/revocations.txt"
key_file = ".runtime/authority.key"
max_ttl_seconds = 3600
bundle_ttl_seconds = 30

# ── Sidecar ───────────────────────────────────────────────────────────────────

[sidecar.interceptor]
mode = "http_proxy"
listen_addr = "127.0.0.1:7474"
drain_timeout_secs = 30

# HTTPS MITM for GitHub and Gmail. LLM traffic tunnels through untouched —
# the LLM SDK does not need to trust the generated firma-ca.
[sidecar.interceptor.https_mitm]
intercept_hosts = ["api.github.com", "gmail.googleapis.com"]
strict_hosts = ["api.github.com", "gmail.googleapis.com"]

[sidecar.policy]
dir = "."
authority_url = "http://127.0.0.1:50051"

[sidecar.ca]
dir = ".runtime/generated-firma-ca"

[sidecar.log]
level = "info"

[sidecar.mapping]
rules_path = "mapping-rules.toml"
rules_paths = ["mappings/github.toml", "mappings/gmail.toml"]
default_protected = true

[sidecar.capability_validation]
clock_skew_tolerance_seconds = 0

[sidecar.constraint_enforcement]
bundle_ttl_seconds = 3600
enforcement_timeout_ms = 50

[sidecar.connector]
default_timeout_ms = 120000

[sidecar.audit]
sink = "file"
file_path = ".runtime/audit.jsonl"
signing_key_path = ".runtime/audit.key"

[sidecar.authority]
connect_timeout_secs = 10
reconnect_min_backoff_ms = 250
reconnect_max_backoff_secs = 30
revocation_readiness_grace_ms = 500
revocation_fail_closed_on_disconnect = false

[sidecar.preflight]
agent_id = "{{ name }}"
session_id = "preflight-session"
requested_actions = [
  "system.install",
  "credential.read",
  "code.read",
  "code.review.read",
  "code.review.submit",
  "code.write",
  "code.merge",
  "issue.read",
  "issue.write",
  "security.alert.read",
  "notification.manage",
  "communication.external.send",
  "communication.internal.send",
]
resource_scope = "*"
authority_pub_key_path = ".runtime/authority.pub"
ttl_seconds = 3600
