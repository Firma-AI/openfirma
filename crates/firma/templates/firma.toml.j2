# Generated by `firma config`.
# NOT FOR PRODUCTION USE — local dev/testing only.
# Run from this directory: firma stack start --config firma.toml

{% if has_server -%}
# ── Authority ─────────────────────────────────────────────────────────────────

[authority]
listen_addr            = "{{ authority_listen }}"
policy_dir             = "policies/"
issuance_policy_dir    = "issuance-policies/"
revocation_file        = '{{ revocation_file }}'
key_file               = '{{ key_file }}'
max_ttl_seconds        = 3600
bundle_ttl_seconds     = 30
tls_cert_path          = '{{ tls_cert_path }}'
tls_key_path           = '{{ tls_key_path }}'

{% endif -%}
{% if has_sidecar -%}
# ── Sidecar ───────────────────────────────────────────────────────────────────

# HTTPS MITM for services that need per-endpoint classification.
# LLM traffic tunnels through untouched — the LLM SDK does not trust firma-ca.
[sidecar.interceptor.https_mitm]
{% if mitm_hosts -%}
intercept_hosts = [{% for h in mitm_hosts %}"{{ h }}"{% if not loop.last %}, {% endif %}{% endfor %}]
strict_hosts    = [{% for h in mitm_hosts %}"{{ h }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% else -%}
intercept_hosts = []
strict_hosts    = []
{% endif %}
[sidecar.policy]
dir = "."

[sidecar.ca]
dir = '{{ ca_dir }}'

[sidecar.log]
level = "info"

[sidecar.mapping]
rules_path  = "mapping-rules.toml"
{% if mapping_paths -%}
rules_paths = [{% for p in mapping_paths %}"{{ p }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif -%}
default_protected = true

[sidecar.capability_validation]
clock_skew_tolerance_seconds = 0

[sidecar.constraint_enforcement]
bundle_ttl_seconds   = 3600
enforcement_timeout_ms = 50

[sidecar.connector]
default_timeout_ms = 120000

[sidecar.audit]
sink             = "file"
file_path        = '{{ audit_file }}'
signing_key_path = '{{ audit_key }}'

[sidecar.authority]
{% if has_connect -%}
url                                   = "{{ authority_url }}"
ca_cert_path                          = '{{ tls_ca_cert_path }}'
public_key_path                       = '{{ authority_pub_key_path }}'
{% endif -%}
connect_timeout_secs                  = 10
reconnect_min_backoff_ms              = 250
reconnect_max_backoff_secs            = 30
revocation_readiness_grace_ms         = 500
revocation_fail_closed_on_disconnect  = false

[sidecar.preflight]
agent_id          = "{{ name }}"
session_id        = "preflight-session"
requested_actions = [
{% for action in requested_actions %}  "{{ action }}",
{% endfor %}]
resource_scope    = "*"
ttl_seconds       = 3600

{% endif -%}
