# Generated by `firma init`. Layer-3 filesystem sandbox profile for: {{ name }}
#
# Apply with:
#   firma run --config firma-run.toml -- <agent-command>
#
# Backend: bwrap (Linux). Hardening knobs are read by the bwrap backend in
# crates/firma-run/src/backend/linux_bwrap.rs.

[profiles.generic]
backend = "bwrap"

[profiles.generic.env_set]
# Read-only rootfs; workspace below and host CWD at launch are the only RW paths.
FIRMA_RUN_BWRAP_ROOTFS_MODE = "readonly"

# Redirect HOME to the per-run runtime dir so the agent cannot read host
# credentials by expanding $HOME.
FIRMA_RUN_BWRAP_RUNTIME_HOME = "true"

# Defense-in-depth tmpfs masks over sensitive credential paths under $HOME.
FIRMA_RUN_BWRAP_MASK_HOME_PATHS = ".ssh,.gnupg,.aws,.config/gcloud,.env"

# Explicit workspace mount. The agent has read-write access to this path.
# The host CWD at launch is also bound RW by default; remove this block if
# you always `cd` into the workspace before invoking `firma run`.
[[profiles.generic.mounts]]
source = "{{ workspace }}"
target = "{{ workspace }}"
read_only = false
