// Firma enforcement schema.
//
// Canonical entity types and action declarations for capability issuance
// (Authority) and constraint enforcement (Sidecar Stage 2). Single source of
// truth for entity type definitions shared across both components.
//
// The 15 action identifiers below are defined by FEP v0.1 §2.3.5. They are
// semantic action classes; transport names and provider names MUST NOT
// appear in action identifiers (FEP §2.3.2). Actions are listed in
// alphabetical order. See
// `docs/markdown/firma_action_class_registry.md` for implementation notes.
//
// Entity UID conventions (matched by both Authority and Sidecar Cedar evaluators):
//   principal: Firma::Agent::"<agent_id>"
//   action:    Firma::Action::"<action_class>"   (e.g., "communication.external.send")
//   resource:  Firma::Resource::"<resource_uri>"
//
// Context attributes populated by ConstraintEnforcer::build_context():
//   session_id         : String  - enclosing session identity
//   timestamp_ms       : Long    - Unix epoch milliseconds at evaluation time
//   params             : String  - JSON-serialized intent.params (ActionParams)
//   risk_score         : Long    - static or pre-computed risk attribute (V1 = 0)
//   budget_remaining   : Long    - ceiling minus consumed, floored; i64::MAX when unbounded
//   session_duration_s : Long    - seconds since claims.issued_at (non-negative)
//   action_count       : Long    - monotonic per-session call counter, 1-based
//   raw_transport      : String  - "http" or "https"; set by the normalizer
namespace Firma {
    entity Agent;
    entity Resource;

    // Shared context shape for all 15 canonical enforcement actions.
    // Must match the JSON object produced by ConstraintEnforcer::build_context().
    //
    // Fields:
    //   session_id              : String — enclosing session identity
    //   timestamp_ms            : Long   — Unix epoch milliseconds at evaluation time
    //   params                  : String — JSON-serialized intent.params (ActionParams)
    //   risk_score              : Long   — static or pre-computed risk attribute (V1 = 0)
    //   budget_remaining        : Long   — ceiling minus consumed, floored; i64::MAX when unbounded
    //   session_duration_s      : Long   — seconds since claims.issued_at (non-negative)
    //   action_count            : Long   — monotonic per-session call counter, 1-based
    //   raw_transport           : String — "http" or "https"; set by the normalizer
    //   transfer_amount         : Long   — amount of this transfer in cents; 0 for non-payment actions
    //   daily_cumulative_amount : Long   — rolling 24-hour committed amount in cents
    //   transfers_last_10m      : Long   — transfer count in the last 10-minute window
    //   same_payee_count_30m    : Long   — transfers to the same payee in the last 30 minutes
    //   session_transfer_count  : Long   — count of transfers in this session
    type EnforcementContext = {
        session_id: String,
        timestamp_ms: Long,
        params: String,
        risk_score: Long,
        budget_remaining: Long,
        session_duration_s: Long,
        action_count: Long,
        raw_transport: String,
        transfer_amount: Long,
        daily_cumulative_amount: Long,
        transfers_last_10m: Long,
        same_payee_count_30m: Long,
        session_transfer_count: Long
    };

    action "account.permission.change" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "browser.purchase" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.external.send" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.internal.send" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "credential.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "credential.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "filesystem.delete" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "filesystem.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "filesystem.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "memory.cross_namespace.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "memory.cross_namespace.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.purchase" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.transfer" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "system.execute" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "system.install" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    // GitHub additions (12 action classes added in the v0.1 registry extension).
    action "code.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.review.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.review.submit" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.destructive" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "code.merge" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "issue.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "issue.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "notification.manage" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "security.alert.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "repo.lifecycle" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "repo.admin" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };
}
