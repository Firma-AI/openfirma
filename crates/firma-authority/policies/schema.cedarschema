// Firma enforcement schema.
//
// Canonical entity types and action declarations for capability issuance
// (Authority) and constraint enforcement (Sidecar Stage 2). Single source of
// truth for entity type definitions shared across both components.
//
// The 15 action identifiers below are defined by FEP v0.1 §2.3.5. They are
// semantic action classes; transport names and provider names MUST NOT
// appear in action identifiers (FEP §2.3.2). Actions are listed in
// alphabetical order. See
// `docs/markdown/firma_action_class_registry.md` for implementation notes.
//
// Entity UID conventions (matched by both Authority and Sidecar Cedar evaluators):
//   principal: Firma::Agent::"<agent_id>"
//   action:    Firma::Action::"<action_class>"   (e.g., "communication.external.send")
//   resource:  Firma::Resource::"<resource_uri>"
//
// Context attributes populated by ConstraintEnforcer::build_context():
//   action_class : String  - canonical action class (mirrors the action UID ID)
//   resource     : String  - target resource URI
//   agent_id     : String  - requesting agent identity
//   session_id   : String  - enclosing session identity
//   timestamp    : String  - ISO 8601 request timestamp
namespace Firma {
    entity Agent;
    entity Resource;

    // Shared context shape for all 15 canonical enforcement actions.
    // Must match the JSON object produced by ConstraintEnforcer::build_context().
    //
    // Fields:
    //   session_id   : String  — enclosing session identity
    //   timestamp_ms : Long    — Unix epoch milliseconds at evaluation time
    //   params       : String  — JSON-serialized intent.params (ActionParams)
    //   risk_score   : Long    — V1 placeholder, always 0
    type EnforcementContext = {
        session_id: String,
        timestamp_ms: Long,
        params: String,
        risk_score: Long
    };

    action "account.permission.change" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "browser.purchase" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.external.send" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "communication.internal.send" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "credential.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "credential.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "filesystem.delete" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "filesystem.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "filesystem.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "memory.cross_namespace.read" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "memory.cross_namespace.write" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.purchase" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "payment.transfer" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "system.execute" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };

    action "system.install" appliesTo {
        principal: [Agent],
        resource: [Resource],
        context: EnforcementContext
    };
}
