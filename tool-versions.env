# Single source of truth for the versions of the dev tools we install.
#
# Consumed by:
#   - the justfile, via `. ./tool-versions.env` in shell recipes
#   - CI workflows, via a "Load tool versions" step that appends the KEY=value
#     lines to $GITHUB_ENV, after which steps reference ${{ env.<KEY> }}
#
# Format rules (must satisfy both consumers):
#   - KEY=value only, one per line; no quotes (Make would keep them verbatim)
#   - no inline comments after a value
#
# NOT here: GitHub Actions `uses:` refs. GitHub forbids expressions in `uses:`,
# so those stay pinned to a commit SHA in each workflow (Renovate bumps them).
PROTOC_VERSION=35.1
DPRINT_VERSION=0.54.0
NODE_VERSION=24.16.0
CROSS_VERSION=0.2.5
CARGO_AUDIT_VERSION=0.22.2
CARGO_DENY_VERSION=0.19.9
CARGO_NEXTEST_VERSION=0.9.137
CARGO_LLVM_COV_VERSION=0.8.4
CARGO_FUZZ_VERSION=0.13.2
CARGO_HAWK_VERSION=0.1.11
CARGO_HAWK_RUST_VERSION=1.97.1
CARGO_DOC_MD_VERSION=0.11.0
UV_VERSION=0.11.32
RUFF_VERSION=0.16.0
CARGO_DIST_VERSION=0.32.0
RELEASE_PLZ_GIT_URL=https://github.com/LukeMathWalker/release-plz
RELEASE_PLZ_REVISION=72723300a073af45327ad7c59e5270901bfe0461
