#!/usr/bin/env sh
set -e

if ! command -v trufflehog >/dev/null 2>&1; then
    echo "warning: trufflehog not found — secret scan skipped (run 'make install-tools' to install)" >&2
    exit 0
fi

# Scan only files staged for this commit. `--since-commit HEAD` scans nothing
# pre-commit (there are no commits past HEAD yet), so we feed the staged blobs
# through filesystem mode instead. `-z` + null-delimited read handles paths
# containing newlines; `ACMR` covers added, copied, modified, and renamed
# entries (renamed-with-edits would slip past plain ACM).
if [ -z "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
    exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

git diff --cached -z --name-only --diff-filter=ACMR | while IFS= read -r -d '' path; do
    dest="$tmp/$path"
    mkdir -p "$(dirname "$dest")"
    git show ":$path" > "$dest" 2>/dev/null || true
done

trufflehog filesystem "$tmp" --no-update --results=verified,unverified,unknown --fail
