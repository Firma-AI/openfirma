# Google AI Studio API key — injected by the sidecar into outbound requests to generativelanguage.googleapis.com.
# The agent never sees this key directly.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_GENAI_API_KEY=your-api-key-here
VECTOR_STORE_ID=xxx

# Supabase (backs db_query and read_file / write_file).
# Every call from the agent is an HTTPS request to <SUPABASE_URL>/rest/v1/...
# or /storage/v1/..., which is what makes the tool call visible to OpenAuthority
# when HTTPS_PROXY points at the sidecar.
SUPABASE_URL=https://your-project-ref.supabase.co
# Paste the "Publishable key" (sb_publishable_...) from the Supabase dashboard
# > Settings > API Keys. This is the modern replacement for the anon key and
# is safe to put in source-controlled / client-side contexts; it's gated by
# Row Level Security. Do NOT paste the Secret key (sb_secret_...) here — that
# bypasses RLS and would give the agent full DB access.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_STORAGE_BUCKET=openauthority-demo

# Resend (backs send_email). HTTPS POST to api.resend.com.
RESEND_API_KEY=re_xxx
RESEND_FROM=demo@your-verified-domain.example

# ipinfo.io token — used by the sidecar for credential injection demo.
# Injected into outbound requests to ipinfo.io when the agent calls get_ip_info.
# The agent process deliberately does not read this variable.
IPINFO_TOKEN=xxx
