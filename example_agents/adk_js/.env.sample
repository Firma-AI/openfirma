# Google AI Studio API key — injected by the sidecar into outbound requests to generativelanguage.googleapis.com.
# The agent never sees this key directly.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_GENAI_API_KEY=your-api-key-here
VECTOR_STORE_ID=xxx
# ipinfo.io token — used by the sidecar for credential injection demo.
# Injected into outbound requests to ipinfo.io when the agent calls get_ip_info.
IPINFO_TOKEN=xzxx
