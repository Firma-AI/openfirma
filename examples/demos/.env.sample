# OpenAI API key — used by the agent for LLM inference.
# In a full Firma deployment the sidecar injects this; for local demos set it here.
OPENAI_API_KEY=sk-xxx

# Resend (backs send_email in demo0). HTTPS POST to api.resend.com.
RESEND_API_KEY=re_xxx
RESEND_FROM=demo@your-verified-domain.example

# GitHub token (used in demo2 to demonstrate credential containment).
# The agent process holds this in its env; the sidecar gates which calls can use it.
GITHUB_TOKEN=ghp_xxx
