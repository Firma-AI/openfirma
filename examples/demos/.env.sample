# ── Demo 0 — fragmented surface ──────────────────────────────────────────
# Resend (backs send_email in demo0). HTTPS POST to api.resend.com.
RESEND_API_KEY=re_xxx
RESEND_FROM=demo@your-verified-domain.example

# Demo0 target repo + open PR. Defaults match agent.py; override to point
# at a real repo + open PR you own.
DEMO0_REPO=acme/api
DEMO0_PR=41

# ── Demo 1 — same host, different path ───────────────────────────────────
# No external credentials needed. The script hits httpbin.org stand-ins
# for the internal /usage and /billing endpoints.

# ── Demo 2 — compromised agent ───────────────────────────────────────────
# GitHub token (used in demo2 to demonstrate credential containment).
# Read by the sidecar at startup via [credentials.github]. The agent
# process scrubs GITHUB_TOKEN from its own env at startup, so the real
# token lives only in the sidecar and is injected per-call after ALLOW.
GITHUB_TOKEN=ghp_xxx

# Demo2 target repo + open PR. Defaults match agent.py; override to point
# at a real repo + open PR you own.
DEMO2_REPO=acme/api
DEMO2_PR=41
