# OpenAI API key — used by the agent for LLM inference.
# In a full Firma deployment the sidecar injects this; for local demos set it here.
OPENAI_API_KEY=sk-xxx

# OpenAI Base URL — uncomment to use local LLMs (e.g., http://localhost:1234/v1
# for LM-Studio). Leave commented to use the OpenAI API. An empty value here
# is loaded as an empty string by python-dotenv and breaks the OpenAI client
# with "Request URL is missing an 'http://' or 'https://' protocol", so do
# not leave the assignment empty.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Resend (backs send_email in demo0). HTTPS POST to api.resend.com.
RESEND_API_KEY=re_xxx
RESEND_FROM=demo@your-verified-domain.example

# GitHub token (used in demo2 to demonstrate credential containment).
# The agent process holds this in its env; the sidecar gates which calls can use it.
GITHUB_TOKEN=ghp_xxx
