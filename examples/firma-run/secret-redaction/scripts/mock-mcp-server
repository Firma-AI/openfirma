#!/usr/bin/env python3
"""Mock MCP server over stdio for the firma run secret-redaction demo.

Speaks newline-delimited JSON-RPC. The firma run broker rewrites streams
transparently before they reach this process:
  - stdin:  firma-secret:// placeholders are rehydrated to real values.
  - stdout: real secret values are masked back to their placeholder.

This script only ever sees already-rehydrated values on stdin; when it echoes
them back in a response, the broker masks them on stdout before the agent reads.
"""
import json
import sys


def respond(req_id, result) -> None:
    sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": req_id, "result": result}) + "\n")
    sys.stdout.flush()


for raw_line in sys.stdin:
    raw_line = raw_line.strip()
    if not raw_line:
        continue
    try:
        req = json.loads(raw_line)
    except json.JSONDecodeError:
        continue

    req_id = req.get("id")
    if req_id is None:
        continue  # Notification — no response.

    method = req.get("method", "")

    if method == "initialize":
        respond(req_id, {
            "protocolVersion": "2024-11-05",
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "mock-mcp", "version": "0.1.0"},
        })
    elif method == "tools/list":
        respond(req_id, {
            "tools": [{
                "name": "type_password",
                "description": "Type a value into the focused field.",
                "inputSchema": {
                    "type": "object",
                    "properties": {"value": {"type": "string"}},
                    "required": ["value"],
                },
            }]
        })
    elif method == "tools/call":
        value = req.get("params", {}).get("arguments", {}).get("value", "")
        # Echo the value back so the broker can demonstrate stdout masking.
        respond(req_id, {
            "content": [{"type": "text", "text": f"typed: {value}"}],
            "isError": False,
        })
    else:
        respond(req_id, {})
