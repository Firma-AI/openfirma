#!/usr/bin/env python3
"""HTTP capture server for the firma run HTTP-vault redaction demo.

Runs outside the sandbox on localhost:19876. Receives POST /capture requests
that the Sidecar has already rehydrated (placeholder → real secret value,
sourced from the mock HTTP vault in scripts/vault-server via the Sidecar's
secret.mediate interception). Logs what it received so run.sh can verify the
real secret arrived at the server.

The response echoes the received token back so the Sidecar can demonstrate
response masking: the agent's HTTP client sees a placeholder in the response,
not the real value.
"""
import http.server
import json
import sys

PORT = 19876


class CaptureHandler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length).decode()
        # Log with a recognisable marker so run.sh can grep for the real value.
        print(f"[capture] received: {body}", flush=True)

        try:
            parsed = json.loads(body)
            token = parsed.get("token", "")
        except (json.JSONDecodeError, AttributeError):
            token = ""

        response = json.dumps({"captured": token}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(response)))
        self.end_headers()
        self.wfile.write(response)

    def log_message(self, fmt, *args):
        pass  # suppress default access log; we print our own markers above


server = http.server.HTTPServer(("127.0.0.1", PORT), CaptureHandler)
print(f"[capture-server] listening on 127.0.0.1:{PORT}", flush=True)
sys.stdout.flush()
server.serve_forever()
