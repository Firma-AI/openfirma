#!/usr/bin/env python3
"""Mock HTTP secrets vault for the firma run HTTP-vault redaction demo.

Runs outside the sandbox on localhost:19877, standing in for a cloud secrets
manager the agent calls directly over HTTP — no CLI, no shim. Responds to
GET /secret/<name> with a JSON body shaped like a typical "get secret value"
API response: `{"Name": "<name>", "SecretString": "<value>"}`.

This server has no knowledge of Firma at all; it just serves the secret. What
keeps the real value from reaching the agent is the Sidecar's own HTTP
interception path: it matches the response against the demo-http-vault
provider configured in firma.toml, extracts SecretString via the configured
JSONPath matcher, and replaces it with a firma-secret:// placeholder before
the agent's HTTP client sees the response body.
"""
import http.server
import json
import re
import sys

PORT = 19877

SECRETS = {
    "login-password": "S3cr3tP%40ssw0rd!",
}


class VaultHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        match = re.fullmatch(r"/secret/([^/]+)", self.path)
        name = match.group(1) if match else None
        value = SECRETS.get(name) if name else None

        if value is None:
            self.send_response(404)
            self.end_headers()
            return

        # Log with a recognisable marker so run.sh can grep for the real value.
        print(f"[vault] served secret for {name!r}", flush=True)

        body = json.dumps({"Name": name, "SecretString": value}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass  # suppress default access log; we print our own marker above


server = http.server.HTTPServer(("127.0.0.1", PORT), VaultHandler)
print(f"[vault-server] listening on 127.0.0.1:{PORT}", flush=True)
sys.stdout.flush()
server.serve_forever()
