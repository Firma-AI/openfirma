# Optional environment for the hero demo. Copy to `.env` and fill.
# Only required for `just demo` (LLM-driven) and `just demo-repl`.
# `just demo-ci` needs no API keys.

# OpenAI API key for the Python `agents-sdk-py` hero driver.
OPENAI_API_KEY=

# IPInfo token wired through the sidecar's [credentials.ipinfo]
# entry. Optional — leave empty to skip IP-info tools.
IPINFO_TOKEN=
